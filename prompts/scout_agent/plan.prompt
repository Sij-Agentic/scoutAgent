{
  "dag": {
    "nodes": [
      {
        "id": "collect_reddit",
        "type": "tool",
        "tool": "reddit_search_and_fetch_threads",
        "params": {
          "keywords": ["customer support automation", "workflow automation", "knowledge management"],
          "subreddits": ["SaaS", "MicroSaaS", "indiehackers", "startups", "Entrepreneur", "SideProject", "Business_Ideas", "growmybusiness", "smallbusiness", "Productivity"],
          "per_query_limit": 50,
          "include_comments": true,
          "comment_depth": 2,
          "comment_limit": 200,
          "use_cache": true
        },
        "code": "# MCP tool call for reddit_search_and_fetch_threads\nimport json\nfrom pathlib import Path\n\n# Define parameters as Python dict\nparams = {\n  \"keywords\": [\"customer support automation\", \"workflow automation\", \"knowledge management\"],\n  \"subreddits\": [\"SaaS\", \"MicroSaaS\", \"indiehackers\", \"startups\", \"Entrepreneur\", \"SideProject\", \"Business_Ideas\", \"growmybusiness\", \"smallbusiness\", \"Productivity\"],\n  \"per_query_limit\": 50,\n  \"include_comments\": true,\n  \"comment_depth\": 2,\n  \"comment_limit\": 200,\n  \"use_cache\": true\n}\n\n# Call the MCP tool (synchronous wrapper)\nresult = mcp_call(\"reddit_search_and_fetch_threads\", params)\n\n# Save result to manifest\nsave_to_manifest(\"stages.collect_reddit\", result)\n\nprint(f\"DEBUG: reddit_search_and_fetch_threads completed, result keys: {list(result.keys()) if isinstance(result, dict) else 'not dict'}\")\nif isinstance(result, dict) and 'threads' in result:\n    threads_count = len(result.get('threads', []))\n    comments_count = sum(len(t.get('comments', [])) for t in result.get('threads', []))\n    print(f\"DEBUG: Saved {threads_count} threads and {comments_count} comments to manifest under stages.collect_reddit\")",
        "language": "python",
        "outputs": ["stages.collect_reddit"]
      }
    ]
  },
  "metadata": {
